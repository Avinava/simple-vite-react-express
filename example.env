# Server
PORT=8080
NODE_ENV=development

# Allowed browser origin(s) for CORS. Leave empty in dev (Vite proxies /api).
# Set to your real site URL in production, e.g. https://app.example.com
CORS_ORIGIN=

# Number of reverse proxies in front of the app (1 on Render/Heroku/nginx). Keeps rate limiting accurate.
TRUST_PROXY=0

# Database
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# The database must already exist (createdb simple-vite-db).
DATABASE_URL="postgres://<username>@localhost:5432/simple-vite-db"

# Optional: add your own variables below
# API_KEY=your-api-key
